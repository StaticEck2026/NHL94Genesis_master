{
  "name": "nhl94-build",
  "version": "1.0.0",
  "description": "Build scripts for NHL 94 Genesis",
  "scripts": {
    "assets": "node tools/prebuild.js retail",
    "extractassets": "node tools/extractAssets94.js lst/nhl94.bin",
    "verify:retail": "node tools/verifyRom.js output/nhl94.bin lst/nhl94.bin",
    "build:retail": "node tools/build.js retail",
    "build:dev": "node tools/build.js dev",
    "build:segacd": "node tools/build.js --segacd",
    "sync": "node tools/sync.js",
    "seg": "node tools/build.js --seg",
    "clean": "node tools/build.js --clean"
  },
  "devDependencies": {
    "crc-32": "^1.2.2"
  },
